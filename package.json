{
  "name": "@yesifan/pi-packages",
  "private": true,
  "type": "module",
  "description": "Monorepo for @yesifan Pi packages",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r run typecheck && biome check .",
    "test": "pnpm -r run test",
    "test:ci": "pnpm -r run test:ci",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm check && pnpm test:ci && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^2.31.1"
  }
}
