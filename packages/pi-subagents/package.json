{
  "name": "@yesifan/pi-subagents",
  "version": "0.3.1",
  "description": "Persistent in-process background subagents for Pi Coding Agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "agents",
    "examples",
    "docs/domain-model.md",
    "docs/specs/yesifan-pi-subagents-spec.md",
    "docs/specs/0001-project-local-subagent-storage.md",
    "docs/specs/0002-prompt-and-session-storage.md",
    "docs/adr/0001-project-local-subagent-storage.md",
    "docs/adr/0002-native-widget-for-background-progress.md",
    "docs/adr/0003-sdk-sessions-and-parent-metadata.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
