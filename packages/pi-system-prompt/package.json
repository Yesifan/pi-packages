{
  "name": "@yesifan/pi-system-prompt",
  "version": "0.3.0",
  "description": "Pi extension: /system-prompt prints the real system prompt (with tool & skill context) sent to the model",
  "keywords": [
    "pi-package",
    "pi-extension",
    "system-prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yesifan/pi-packages.git",
    "directory": "packages/pi-system-prompt"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.js",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/development.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
