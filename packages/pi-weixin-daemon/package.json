{
  "name": "@yesifan/pi-weixin-daemon",
  "version": "0.6.14",
  "description": "Connect Weixin iLink Bot with Pi Coding Agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-wx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.attribution"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --exclude 'test/integration/bridge-real.test.ts' --exclude 'test/integration/ui-real.test.ts' --exclude 'test/integration/pi-runtime.test.ts' --exclude 'test/integration/runtime-extension.test.ts'",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "typebox": "catalog:",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
